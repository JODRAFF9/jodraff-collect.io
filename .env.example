# Copier en .env et adapter. Aucun secret reel ne doit figurer dans ce fichier
# d'exemple ni etre commit.

# --- Identite -------------------------------------------------------------
APP_NAME="Jodraff Collect"
ENVIRONMENT=local                 # local | dev | prod
SECRET_KEY=changez-cette-cle-en-production
TOKEN_TTL_SECONDS=43200

# --- Base operationnelle (OLTP) -------------------------------------------
# Local
DATABASE_URL=sqlite:///./var/operational.db
# Azure PostgreSQL
# DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@serveur.postgres.database.azure.com:5432/collect?sslmode=require

SQL_ECHO=false

# --- Lakehouse et entrepot ------------------------------------------------
# Local : repertoire de fichiers Parquet pilote par DuckDB
LAKE_ROOT=./var/lake
WAREHOUSE_URL=./var/warehouse.duckdb
WAREHOUSE_DIALECT=duckdb          # duckdb | tsql

# Azure : ADLS Gen2 et entrepot Fabric ou Azure SQL
# LAKE_ROOT=abfss://lakehouse@moncompte.dfs.core.windows.net
# WAREHOUSE_URL=mssql+pyodbc://serveur.database.windows.net/gold?driver=ODBC+Driver+18+for+SQL+Server
# WAREHOUSE_DIALECT=tsql

# --- Rapports -------------------------------------------------------------
LATEX_ENGINE=pdflatex             # pdflatex | xelatex | tectonic
REPORTS_OUTPUT_DIR=./var/reports

# --- Divers ---------------------------------------------------------------
DEFAULT_LANGUAGE=fr
PAGE_SIZE=50
